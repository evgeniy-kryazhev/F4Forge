<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>F4Forge.Net</AssemblyName>
        <RootNamespace>F4Forge</RootNamespace>
        <Version>0.3.2</Version>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="../../build/generated/bindings/Bindings.g.cs" Link="bridge/Generated/Bindings.g.cs" />
        <InternalsVisibleTo Include="F4Forge.Net.Tests" />
    </ItemGroup>
    <Target Name="GenerateCommonLibBindings" BeforeTargets="CoreCompile" Condition="'$(F4ForgeBindingsReady)' != 'true'">
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)/../.." Command="xmake build F4Forge.Bindings" />
    </Target>
</Project>
